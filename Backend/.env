NODE_ENV=development
PORT=4000

MONGO_URI=

#JWT Acess Key
JWT_ACCESS_SECRET=your_super_secret_access_key_change_this
JWT_ACCESS_EXPIRES=15m
#JWT Refresh Key
JWT_REFRESH_SECRET_PRIMARY=your_super_secret_refresh_primary_key_change_this
JWT_REFRESH_SECRET_SECONDARY=your_super_secret_refresh_secondary_key_change_this
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_primary_key_change_this

CLIENT_URL=http://localhost:5173

EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
EMAIL_FROM=noreply@eventhub.com
